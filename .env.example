# Clé API Anthropic (Claude) — jamais exposée côté client
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Clé API Pexels (gratuite, à créer sur pexels.com/api)
PEXELS_API_KEY=xxxxxxxx

# Supabase — projet dédié à Vitrine Express
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx
# Copie ici la "Secret key" (format sb_secret_...) trouvée dans
# Settings > API Keys > Secret keys. C'est le nouveau format Supabase,
# qui remplace l'ancienne "service_role key" — même usage, même niveau
# de droits. Ne jamais la mettre dans le code React (frontend).
# ATTENTION : cette clé a tous les droits, elle ne doit exister
# QUE côté serveur (dans les fonctions /api), jamais dans le code React.
